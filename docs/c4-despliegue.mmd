C4Deployment
  title Despliegue — CI/CD en Google Cloud

  Deployment_Node(dev, "Laptop de la ponente", "git y VS Code") {
    Container(repo, "Repositorio", "Python 3.12", "Código y pruebas")
  }

  Deployment_Node(gh, "GitHub Actions", "runner ubuntu-latest") {
    Container(ci, "Pipeline de pruebas", "ruff y pytest", "Bloquea el despliegue si falla")
    Container(cd, "Pipeline de despliegue", "identidad federada y gcloud", "Sin llaves de servicio almacenadas")
  }

  Deployment_Node(gcp, "Google Cloud", "proyecto de la charla") {
    Deployment_Node(ar, "Artifact Registry") {
      Container(imagen, "Imagen OCI", "python:3.12-slim", "Etiquetada con el SHA del commit")
    }
    Deployment_Node(run, "Cloud Run", "servicio gestionado") {
      Container(servicio, "oraculo-api", "FastAPI", "max-instances 1 por el estado en memoria")
    }
    Deployment_Node(iam, "IAM") {
      Container(sa, "Cuenta de servicio", "identidad", "roles/aiplatform.user; no hay secretos que montar")
    }
  }

  Rel(repo, ci, "push y pull request")
  Rel(ci, cd, "verde en main")
  Rel(cd, imagen, "docker push")
  Rel(imagen, servicio, "gcloud run deploy")
  Rel(servicio, sa, "actúa como")

  UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")
