# Copia a .env y ajusta. Ninguna de estas variables es un secreto:
# la autenticación contra Vertex AI usa las credenciales del entorno.

# Proyecto de GCP. Si lo dejas vacío, el oráculo cae al adaptador simulado.
GOOGLE_CLOUD_PROJECT=

# "global" o una región concreta, p. ej. us-central1
VERTEX_LOCATION=global

# Modelo GA actual. Los gemini-2.5 se retiran el 20/10/2026.
ORACLE_MODEL=gemini-3.8-flash

# "vertex" (real) o "mock" (ensayos sin red ni costo)
ORACLE_BACKEND=mock

# Política de aceptación del veredicto
ORACLE_MIN_CONFIDENCE=0.8
ORACLE_MIN_SOURCES=2

# Respuestas mínimas para que el censo de la sala resuelva
CENSUS_MIN_RESPONSES=5

# Preguntas que se siembran: oraculo | agregacion | mixta | encuadre | nube | nube_real.
# Se combinan con «+», por ejemplo encuadre+nube_real. Ver docs/PREGUNTAS.md.
SEED_SET=oraculo

# Preguntas desde las noticias: la lista de medios y su inclinación, cada una con su
# fuente (por defecto app/medios.json). En ensayo se usan siempre dos medios ficticios.
# MEDIOS_ARCHIVO=app/medios.json
# Créditos que arriesga cada agente de noticias por pregunta.
AGENTES_PRESUPUESTO=200

# Si se define, crear y resolver mercados exige la cabecera X-Presenter-Key.
# Vacía en local; en Cloud Run defínela siempre.
PRESENTER_KEY=

# Nube simulada. Con la misma semilla, el mismo mundo: ensaya y decide si quieres
# saber el resultado de antemano o cambiar la semilla ese día.
SIM_SEED=7
SIM_AGENTS=12
# Segundos por tick. 1.0 cierra una generación (24 ticks) en 24 s.
SIM_TICK_SECONDS=1.0

# Infraestructura real: apagado | ensayo (nube falsa) | plan (validateOnly) | real
INFRA_MODE=apagado
# Solo para plan y real: la imagen de los nodos y la cuenta con la que corren.
NODO_IMAGEN=
NODO_CUENTA=
# Límites de costo de ActuationPolicy y la vigilia.
INFRA_MAX_INSTANCIAS_MINIMAS=2
INFRA_MAX_POR_REGION=2
INFRA_MAX_SERVICIOS=3
INFRA_TTL_SEGUNDOS=1800
INFRA_RPS_POR_INSTANCIA=10
INFRA_INTERVALO=10

# Seguridad. En Cloud Run (K_SERVICE definido) la API no arranca sin una clave de
# al menos 32 caracteres; en producción la clave viene de Secret Manager.
# PRESENTER_KEY=          (arriba en este archivo, si quieres probarla en local)
# Documentación de la API: abierta en local, cerrada en Cloud Run salvo API_DOCS=1.
API_DOCS=1
# Cloud Scheduler se autentica con OIDC: cuenta que firma y URL de la vigilia.
VIGILIA_CUENTA=
VIGILIA_AUDIENCIA=

# Mercado real (con INFRA_MODE=ensayo|plan|real): agentes con servicios propios.
MERCADO_AGENTES=4
MERCADO_MAX_CALIENTES=1      # instancias mínimas pagadas: lo único que cobra en reposo
MERCADO_MAX_PETICIONES=12    # peticiones reales de trabajo por ciclo, sin importar la demanda

# Código de sala para entrar desde el móvil: «auto» lo genera al arrancar y lo muestra la
# proyección de quien modera. Vacío desactiva el código (solo en local: en producción no arranca).
SALA_CODIGO=auto
